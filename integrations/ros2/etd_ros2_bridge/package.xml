<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>etd_ros2_bridge</name>
  <version>0.2.0</version>
  <description>
    ETD Skill Runtime — ROS 2 bridge package.
    Provides action server and client nodes for executing ETD skill packages
    via ROS 2 action protocol (etd/ExecuteSkill action type).
  </description>

  <maintainer email="etd@example.com">ETD Lab</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosidl_default_runtime</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rosidl_interface_packages/>
  </export>
</package>
