{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etd-spec.local/chs_profiles.schema.json",
  "title": "ETD CHS Profiles",
  "description": "Task-context profiles (CHS = task Context, Hardware constraints, Safety parameters). Each profile defines a named execution context for the skill.",
  "type": "object",
  "required": ["profiles"],
  "additionalProperties": false,
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["name", "taskType", "payloadKg", "speedProfile", "bodyMode", "armMode", "wristMode"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "description": "Unique profile identifier within the package"
        },
        "taskType": {
          "type": "string",
          "enum": ["PICK_PLACE", "ASSEMBLY", "INSPECTION", "COBOT_ASSIST", "COBOT", "TRANSPORT", "WELD", "NAVIGATION", "HUMANOID_FETCH", "ASSIST"]
        },
        "payloadKg": {
          "type": "number",
          "minimum": 0
        },
        "fragility": {
          "type": "string",
          "enum": ["low", "medium", "high", "variable"]
        },
        "speedProfile": {
          "type": "string",
          "enum": ["fast", "normal", "gentle", "slow_scan", "industrial_safe", "precision", "human_aware"]
        },
        "bodyMode": {
          "type": "string",
          "description": "BVS body posture mode for this task"
        },
        "armMode": {
          "type": "string",
          "description": "SVS arm trajectory mode for this task"
        },
        "wristMode": {
          "type": "string",
          "description": "MVS wrist contact mode for this task"
        },
        "forceWindowN": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "[min_N, max_N] force window in Newtons. Second element must be >= first."
        },
        "graspMode": {
          "type": "string",
          "enum": ["parallel_grip", "soft_contact", "pinch", "adaptive", "vacuum", "magnetic", "secure_hold", "compliant"]
        },
        "precisionMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "humanAwareRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Radius in meters within which human-aware behavior is enforced"
        },
        "yieldToHuman": { "type": "boolean" }
      }
    }
  }
}
